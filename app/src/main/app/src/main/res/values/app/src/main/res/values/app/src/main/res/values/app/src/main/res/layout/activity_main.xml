<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cafe_cream"
    android:padding="16dp">

    <!-- Top Status Bar: Title, Score, Streak -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/cafe_dark"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="☕ Coffee Track"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 0"
            android:textColor="@color/cafe_caramel"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingEnd="12dp" />

        <TextView
            android:id="@+id/tvStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Streak: x1"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Customer Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCustomerAvatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:text="🧑‍💼"
                    android:textSize="36sp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tvCustomerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customer: Alex"
                        android:textColor="@color/cafe_dark"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvOrderSpeech"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\"I would like a Hot Cappuccino, please!\""
                        android:textColor="@color/cafe_dark"
                        android:textSize="14sp"
                        android:textStyle="italic" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbCustomerPatience"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="100" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Status Message -->
    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Prepare the matching order below!"
        android:textColor="@color/cafe_accent"
        android:textStyle="bold"
        android:textSize="14sp" />

    <!-- Station Menu Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Barista Counter (Select Item to Serve):"
        android:textColor="@color/cafe_dark"
        android:textStyle="bold"
        android:textSize="15sp" />

    <!-- Kitchen / Barista Grid -->
    <GridLayout
        android:id="@+id/gridMenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="2"
        android:rowCount="3"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnItem1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="☕ Espresso"
            android:textSize="13sp"
            android:backgroundTint="@color/cafe_dark" />

        <Button
            android:id="@+id/btnItem2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="🥛 Cappuccino"
            android:textSize="13sp"
            android:backgroundTint="@color/cafe_dark" />

        <Button
            android:id="@+id/btnItem3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="🍵 Matcha Latte"
            android:textSize="13sp"
            android:backgroundTint="@color/cafe_dark" />

        <Button
            android:id="@+id/btnItem4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="🫖 Turkish Coffee"
            android:textSize="13sp"
            android:backgroundTint="@color/cafe_dark" />

        <Button
            android:id="@+id/btnItem5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="🥐 Croissant"
            android:textSize="13sp"
            android:backgroundTint="@color/cafe_caramel" />

        <Button
            android:id="@+id/btnItem6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="🧁 Berry Muffin"
            android:textSize="13sp"
            android:backgroundTint="@color/cafe_caramel" />
    </GridLayout>

    <!-- Restart / Reset -->
    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Restart Game"
        android:backgroundTint="@color/cafe_accent"
        android:layout_marginTop="8dp" />
</LinearLayout>
